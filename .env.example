# Copie este arquivo para .env e preencha com os dados da conta de FTP da Hostinger
# (hPanel > Sites > Gerenciar > Arquivos > Contas FTP).
# NUNCA commite o arquivo .env — ele já está no .gitignore.
# Em produção (GitHub Actions), estes mesmos nomes são lidos dos Secrets do repositório.

FTP_HOST=ftp.seudominio.com.br
FTP_USER=usuario_ftp
FTP_PASSWORD=
FTP_PORT=21
FTP_SECURE=true
FTP_REMOTE_ROOT=/public_html/
